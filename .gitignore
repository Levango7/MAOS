__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
# Coverage reports (pytest --cov artifact)
.coverage
htmlcov/
# Local tooling state (ZCode session/plan files)
.zcode/

# Signing keys — NEVER commit private keys (test or production)
# Test signing key (used by issue_test_license.py / issue_license.py default)
scripts/test_signing_key.pem
# Any PEM keys generated under scripts/ or data/ (e.g. via --gen-keys)
scripts/*.pem
data/*.pem
# License key files (issued licenses, not source code)
data/test_license.key
data/license.key
# CRL cache (runtime artifact)
data/crl_cache.json
# Runtime logs
data/*.log 
# Integrity manifest — 已提交入库（v5.2.1 起）：随源码分发保证 clone 即自洽、
# wheel 构建（force-include）始终有文件。代码变更后需重签并提交
# （scripts/sign_enterprise_modules.py，发布前用生产私钥重签）。
